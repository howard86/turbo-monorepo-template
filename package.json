{
  "name": "turbo-monorepo-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "dev": "turbo run dev --no-cache --parallel --continue",
    "fix": "ultracite fix",
    "knip": "knip",
    "test": "turbo run build --filter=@org/docs^... && bun test",
    "test:watch": "bun test --watch",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "turbo run build --filter=@org/docs^... && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@happy-dom/global-registrator": "20.11.12",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.0",
    "husky": "9.1.7",
    "happy-dom": "20.11.12",
    "knip": "6.32.3",
    "lint-staged": "17.4.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "ultracite": "7.10.7"
  },
  "packageManager": "bun@1.3.14"
}
