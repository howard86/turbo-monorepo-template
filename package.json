{
  "name": "turbo-monorepo-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --no-cache --parallel --continue",
    "lint": "turbo run lint",
    "test": "turbo run build --filter=@org/docs^... && bun test",
    "test:watch": "bun test --watch",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write --list-different .",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "turbo run build --filter=@org/docs^... && changeset publish",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@org/prettier-config": "workspace:*",
    "@happy-dom/global-registrator": "20.11.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "eslint": "^8.47.0",
    "eslint-config-org": "workspace:*",
    "husky": "^9.0.0",
    "happy-dom": "20.11.1",
    "lint-staged": "^16.0.0",
    "next": "16.2.12",
    "prettier": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.0.0",
    "turbo": "2.9.14",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
